{
	"useTabs": true,
	"arrowParens": "always",
	"bracketSpacing": true,
	"printWidth": 140,
	"proseWrap": "always",
	"quoteProps": "consistent",
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"endOfLine": "lf",
	"tabWidth": 4,
	"plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-packagejson"],
	"importOrder": [
		"<BUILTIN_MODULES>",
		"<THIRD_PARTY_MODULES>",
		"^@repo/(.*)$",
		"^@/",
		"^\\.\\./",
		"^\\.(?!.*/index$)(?!^\\.$)(?!^\\./$)\\/.+$",
		"^\\.(/index)?$"
	],
	"importOrderTypeScriptVersion": "7.0.2",
	"importOrderCaseSensitive": false,
	"overrides": [
		{
			"files": "*.jsonc",
			"options": {
				"trailingComma": "none"
			}
		}
	]
}
