{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "supabase-keepalive",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",

	"workers_dev": false,
	"preview_urls": false,

	"triggers": {
		"crons": ["0 12 * * *"]
	},

	"secrets": {
		"required": ["CONFIG"]
	},

	"observability": {
		"enabled": true
	}
}
